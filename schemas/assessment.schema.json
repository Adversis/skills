{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Adversis security assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "system", "base_revision", "revision", "scope", "summary", "affected_requirements", "findings", "checks", "limitations"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "enum": ["review", "verification"] },
    "system": { "$ref": "#/definitions/text" },
    "base_revision": { "$ref": "#/definitions/optionalText" },
    "revision": { "$ref": "#/definitions/optionalText" },
    "source_assessment": { "$ref": "#/definitions/text" },
    "scope": { "$ref": "#/definitions/sources" },
    "summary": { "$ref": "#/definitions/text" },
    "affected_requirements": { "$ref": "#/definitions/ids" },
    "findings": { "type": "array", "items": { "$ref": "#/definitions/finding" } },
    "checks": {
      "type": "object",
      "propertyNames": { "pattern": "^SEC-[0-9]{3,}/[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": { "$ref": "#/definitions/check" }
    },
    "limitations": { "type": "array", "items": { "$ref": "#/definitions/text" } }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          { "properties": { "base_revision": { "type": "null" } } },
          { "properties": { "revision": { "type": "null" } } }
        ]
      },
      "then": { "properties": { "limitations": { "minItems": 1 } } }
    }
  ],
  "definitions": {
    "text": { "type": "string", "pattern": "\\S" },
    "optionalText": { "anyOf": [{ "$ref": "#/definitions/text" }, { "type": "null" }] },
    "sources": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/definitions/text" }
    },
    "ids": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^SEC-[0-9]{3,}$" }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["observation", "impact", "evidence", "requirement_ids", "action"],
      "properties": {
        "observation": { "$ref": "#/definitions/text" },
        "impact": { "$ref": "#/definitions/text" },
        "evidence": { "$ref": "#/definitions/sources" },
        "requirement_ids": { "$ref": "#/definitions/ids" },
        "action": { "$ref": "#/definitions/text" }
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "environment", "evidence"],
      "properties": {
        "revision": { "$ref": "#/definitions/text" },
        "environment": { "$ref": "#/definitions/text" },
        "evidence": { "$ref": "#/definitions/sources" }
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "test_ref", "detail", "run"],
      "properties": {
        "status": { "enum": ["not_run", "blocked", "passed", "failed"] },
        "test_ref": { "$ref": "#/definitions/optionalText" },
        "detail": { "$ref": "#/definitions/text" },
        "run": { "anyOf": [{ "$ref": "#/definitions/run" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["passed", "failed"] } } },
          "then": { "properties": { "test_ref": { "$ref": "#/definitions/text" }, "run": { "$ref": "#/definitions/run" } } }
        },
        {
          "if": { "properties": { "status": { "const": "not_run" } } },
          "then": { "properties": { "run": { "type": "null" } } }
        }
      ]
    }
  }
}
